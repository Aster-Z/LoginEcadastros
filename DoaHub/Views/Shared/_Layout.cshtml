<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DoaHub</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            document.querySelectorAll('.inputic input').forEach(function(input) {
                const container = input.closest('.inputic');

                function atualizarIcone() {
                    container.classList.toggle('has-value', input.value.trim() !== '');
                }

                input.addEventListener('input', atualizarIcone);
                input.addEventListener('change', atualizarIcone);
                atualizarIcone();
            });
        });
    </script>
</head>

<body>
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <defs>
        <symbol id="i-mail" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></symbol>
        <symbol id="i-lock" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></symbol>
        <symbol id="i-droplet" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2s7 8 7 13a7 7 0 1 1-14 0c0-5 7-13 7-13z"/></symbol>
        <symbol id="i-pin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s7-7.5 7-12a7 7 0 1 0-14 0c0 4.5 7 12 7 12z"/><circle cx="12" cy="10" r="2.5"/></symbol>
        <symbol id="i-shield" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6l8-4z"/></symbol>
        <symbol id="i-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></symbol>
        <symbol id="i-logout" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="M16 17l5-5-5-5"/><path d="M21 12H9"/></symbol>
        <symbol id="i-user" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/></symbol>
        <symbol id="i-phone" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4h3l2 5-2.5 1.5a11 11 0 0 0 5 5L14 13l5 2v3a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/></symbol>
        <symbol id="i-idcard" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="8.5" cy="11" r="1.8"/><path d="M5.5 16c.5-1.7 1.8-2.5 3-2.5s2.5.8 3 2.5"/><path d="M14 10h5M14 13h5"/></symbol>
      </defs>
    </svg>

    <header class="nav">
        <a class="logo" asp-controller="Home" asp-action="Index">
            <img src="~/images/logo.png" alt="Logo DoaHub" class="mark" />
            <span>DoaHub</span>
        </a>

        @if (User.Identity?.IsAuthenticated == true)
        {
            <nav class="links">
                @if (User.IsInRole(Roles.Doador))
                {
                    <a asp-controller="Doador" asp-action="Index">Painel</a>
                }
                @if (User.IsInRole(Roles.Instituicao))
                {
                    <a asp-controller="Instituicao" asp-action="Index">Painel</a>
                }
            </nav>
            <span class="userinfo">Olá, @User.Identity.Name</span>
            <form asp-controller="Account" asp-action="Logout" method="post" class="inline">
                <button type="submit" class="btn-out"><svg class="ic" aria-hidden="true"><use href="#i-logout"/></svg>Sair</button>
            </form>
        }
        else
        {
            <nav class="links"></nav>
            <a class="btn-out" asp-controller="Account" asp-action="Login">Entrar</a>
        }
    </header>

    <main class="content@(((bool?)ViewData["FullBleed"] ?? false) ? " full" : "")">
        @RenderBody()
    </main>

    <footer class="footer">
        <span>DoaHub &copy; @DateTime.Now.Year</span>
    </footer>
</body>
</html>
