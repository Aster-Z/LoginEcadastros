@{
    ViewData["Title"] = "Início";
}

<section class="hero">
    <h1>Cada doação encontra quem precisa</h1>
    <p>O DoaHub conecta doadores de sangue a hemocentros, hospitais e bancos de sangue com estoque baixo perto de você.</p>
    <div class="actions">
        <a class="btn-link p" asp-controller="Account" asp-action="Login">Entrar</a>
        <a class="btn-link g" asp-controller="Account" asp-action="Register">Criar conta</a>
    </div>

    <ul class="hero-features">
        <li><svg aria-hidden="true"><use href="#i-droplet"/></svg>Alertas por tipo sanguíneo</li>
        <li><svg aria-hidden="true"><use href="#i-pin"/></svg>Campanhas perto de você</li>
        <li><svg aria-hidden="true"><use href="#i-shield"/></svg>Instituições validadas</li>
    </ul>
</section>
